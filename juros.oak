// Cálculo dos juros, sendo que precisa de parcelas pra isso
// Versão 0.1: 05/03/2025: versão feita sem muito conhecimento de Oak
//        0.2: 22/07/2026: de (indice * 30.0) para (indice * Periodo)
//        0.3: 30/10/2026: casos especiais substituídos por 0.0s, colocados os corpos das funções em blocos, melhorados comentários,
//                         preenche açúcar separada de rPreenche, acrescentadas validações de variáveis, parâmetros e cálculos,
//                         funções recursivas alteradas para permitir Tail Call Optimization (TCO); incluindo posição das inclusões de elementos em rPreenche

std := import('std')

Quantidade := 3
Composto := true
Periodo := 30.0
Pagamentos := []
Pesos := []

// função recursiva que preenche os arrays
fn rPreenche(indice) {
    if indice > Quantidade {
        true -> ?
        _ -> {
            Pagamentos << (indice * Periodo)
            Pesos << 1.0
            rPreenche(indice + 1)
        }
    }
}

// função açúcar recursiva que preenche os arrays
fn preenche() {
    rPreenche(1)
}

// função recursiva que calcula a somatória de Pesos[]
fn rGetPesoTotal(indice, acumulador) {
    if indice < 0 {
        true -> acumulador
        _ -> rGetPesoTotal(indice - 1, Pesos.(int(indice)) + acumulador)
    }
}

// função açúcar que calcula a somatória de Pesos[]
fn getPesoTotal() {
    rGetPesoTotal(Quantidade - 1, 0.0)
}

// função recursiva que calcula a soma do amortecimento de todas as parcelas para juros compostos
fn rJurosCompostos(indice, juros, acumulador) {
    if indice < 0 {
        true -> acumulador
        _ -> rJurosCompostos(indice - 1, juros, Pesos.(int(indice)) / pow(1.0 + juros / 100.0, Pagamentos.(int(indice)) / Periodo) + acumulador)
    }
}

// função recursiva que calcula a soma do amortecimento de todas as parcelas para juros simples
fn rJurosSimples(indice, juros, acumulador) {
    if indice < 0 {
        true -> acumulador
        _ -> rJurosSimples(indice - 1, juros, Pesos.(int(indice)) / (1.0 + juros / 100.0 * Pagamentos.(int(indice)) / Periodo) + acumulador)
    }
}

// função que calcula o acréscimo a partir dos juros e parcelas
fn jurosParaAcrescimo(juros) {
    pesoTotal := getPesoTotal()
    if Quantidade < 1 | Periodo <= 0.0 | pesoTotal <= 0.0 | juros <= 0.0 {
        true -> 0.0
        _ -> {
            if Composto {
                true -> acumulador := rJurosCompostos(Quantidade - 1, juros, 0.0)
                _ -> acumulador := rJurosSimples(Quantidade - 1, juros, 0.0)
            }
            if acumulador <= 0.0 {
                true -> 0.0
                _ -> (pesoTotal / acumulador - 1.0) * 100.0
            }
        }
    }
}

// função recursiva que calcula os juros a partir do acréscimo e parcelas
fn rAcrescimoParaJuros(acrescimo, minDiferenca, iteracaoAtual, minJuros, maxJuros, medJuros) {
    if iteracaoAtual = 0 | (maxJuros - minJuros) < minDiferenca {
        true -> medJuros
        _ -> if jurosParaAcrescimo(medJuros) < acrescimo {
            true -> rAcrescimoParaJuros(acrescimo, minDiferenca, iteracaoAtual - 1, medJuros, maxJuros, (medJuros + maxJuros) / 2.0)
            _ -> rAcrescimoParaJuros(acrescimo, minDiferenca, iteracaoAtual - 1, minJuros, medJuros, (minJuros + medJuros) / 2.0)
        }
    }
}

// função açúcar que calcula os juros a partir do acréscimo e parcelas
fn acrescimoParaJuros(acrescimo, precisao, maxIteracoes, maxJuros) {
    pesoTotal := getPesoTotal()
    if Quantidade < 1 | Periodo <= 0.0 | pesoTotal <= 0.0 | acrescimo <= 0.0 | precisao < 1 | maxIteracoes < 1 | maxJuros <= 0.0 {
        true -> 0.0
        _ -> rAcrescimoParaJuros(acrescimo, pow(0.1, precisao), maxIteracoes, 0.0, maxJuros, maxJuros / 2.0)
    }
}

// para preencher os arrays com o tamanho de Quantidade e com os valores 30.0, 60.0, 90.0... e 1.0 ,1.0 , 1.0...
preenche()

// calcula e guarda os resultados das funções
pesoTotal := getPesoTotal()
acrescimoCalculado := jurosParaAcrescimo(3.0)
jurosCalculado := acrescimoParaJuros(acrescimoCalculado, 15, 65, 50.0)

// imprime os resultados
std.println('Peso total = ' + string(pesoTotal))
std.println('Acréscimo = ' + string(acrescimoCalculado))
std.println('Juros = ' + string(jurosCalculado))
