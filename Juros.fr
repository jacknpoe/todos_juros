-- Cálculo dos juros, sendo que precisa de listas pra isso
-- Versão 0.1: 15/02/2026: versão feita sem muito conhecimento de Frege a partir de Haskell
--        0.2: 12/10/2026: recursivas alteradas para permitir Tail Call Optimization (TCO), + variáveis em main e geradoras,
--                         exp normalizada, saídas de recursão de exponenciais racionalizadas

module Juros where
import Data.List  -- listas: construção, decomposição, sum
import Prelude.Math(floor)  -- floor onde expnat() normaliza

-- ############### FUNÇÕES FORA DO DOMÍNIO DO PROBLEMA, IMPLEMENTAM EXPONENCIAÇÕES ###############

-- ln(2) pré-calculado é usado na normalização de exp
ln2 :: Double
ln2 = 0.6931471805599453

-- função recursiva que calcula double ^ long; essa função é especial para expoentes inteiros (usada por exp e para a precisão)
rpowint :: Double -> Long -> Double -> Double
rpowint base expoente acumulador
  | expoente == 0 = acumulador
  | expoente `mod` 2 == 0 = rpowint (base * base) (expoente `div` 2) acumulador
  | otherwise = rpowint (base * base) ((expoente - 1) `div` 2) (base * acumulador)

-- função que calcula double ^ long
powint :: Double -> Long -> Double
powint base expoente
  | expoente < 0 = rpowint (1.0 / base) (-expoente) 1.0
  | otherwise = rpowint base expoente 1.0

-- função recursiva que calcula o logaritmo natural usando uma série de Taylor
rlognat :: Int -> Double -> Double -> Double -> Double
rlognat indice ip termo soma
  | soma + termo == soma = 2.0 * soma
  | otherwise = rlognat (indice + 1) ip (termo * ip * ip) (soma + termo / (2.0 * fromIntegral indice - 1.0))

-- função que calcula o logaritmo natural
lognat :: Double -> Double
lognat valor = rlognat 1 ((valor - 1.0) / (valor + 1.0)) ((valor - 1.0) / (valor + 1.0)) 0.0

-- função recursiva que calcula a exponencial 
rexpnat :: Double -> Double -> Double -> Double -> Double
rexpnat indice soma termo valor
  | soma + termo == soma = soma
  | otherwise = rexpnat (indice + 1.0) (soma + termo) (termo * valor / (indice + 1.0)) valor

-- função que calcula a exponencial normalizada
expnat :: Double -> Double
expnat valor =
  let ajuste = (floor (valor / ln2)).long
      x = valor - fromIntegral ajuste * ln2
  in rexpnat 1.0 1.0 x x * powint 2.0 ajuste

-- função que calcula base elevada a expoente usando as funções expnat e lognat
power :: Double -> Double -> Double
power base expoente = expnat (expoente * lognat base)

-- ############### FUNÇÕES E DECLARAÇÕES DENTRO DO DOMÍNIO DO PROBLEMA (MATEMÁTICA FINANCEIRA) ###############

-- estrutura básica para simplificar as chamadas
quantidade :: Int
quantidade = 300000
composto :: Bool
composto = True
periodo :: Double
periodo = 30.0

-- função recursiva TCO que monta a lista Pagamentos
rCriaPagamentos :: Int -> [Double] -> [Double]
rCriaPagamentos 0 acumulador = acumulador
rCriaPagamentos indice acumulador = rCriaPagamentos (indice - 1) (fromIntegral indice * periodo : acumulador)

-- função açúcar que monta a lista Pagamentos
criaPagamentos :: [Double]
criaPagamentos = rCriaPagamentos quantidade []

-- função recursiva TCO que monta a lista Pesos
rCriaPesos :: Int -> [Double] -> [Double]
rCriaPesos 0 acumulador = acumulador
rCriaPesos indice acumulador =  rCriaPesos (indice - 1) (1.0 : acumulador)

-- função açúcar que monta a lista Pesos
criaPesos :: [Double]
criaPesos = rCriaPesos quantidade []

pagamentos :: [Double]
pagamentos = criaPagamentos
pesos :: [Double]
pesos = criaPesos

-- função que calcula a somatória de pesos
getPesoTotal :: Double
getPesoTotal = sum pesos

-- função que calcula a soma do amortecimento de todas as parcelas para juros compostos
rJurosCompostos :: [Double] -> [Double] -> Double -> Double -> Double
rJurosCompostos [] [] _ acumulador = acumulador
rJurosCompostos [] (_:_) _ acumulador = acumulador
rJurosCompostos (_:_) [] _ acumulador = acumulador
rJurosCompostos (pagH:pagT) (pesH:pesT) juros acumulador = rJurosCompostos pagT pesT juros (pesH / power (1.0 + juros / 100.0) (pagH / periodo) + acumulador)

-- função que calcula a soma do amortecimento de todas as parcelas para juros simples
rJurosSimples :: [Double] -> [Double] -> Double -> Double -> Double
rJurosSimples [] [] _ acumulador = acumulador
rJurosSimples [] (_:_) _ acumulador = acumulador
rJurosSimples (_:_) [] _ acumulador = acumulador
rJurosSimples (pagH:pagT) (pesH:pesT) juros acumulador = rJurosSimples pagT pesT juros (pesH / (1.0 + juros / 100.0 * pagH / periodo) + acumulador)

-- função que calcula o acréscimo a partir dos juros e dados comuns (como parcelas)
jurosParaAcrescimo :: Double -> Double
jurosParaAcrescimo juros
  | composto = (getPesoTotal / (rJurosCompostos pagamentos pesos juros 0.0) - 1.0) * 100.0
  | otherwise = (getPesoTotal / (rJurosSimples pagamentos pesos juros 0.0) - 1.0) * 100.0

-- função recursiva que calcula os juros a partir do acréscimo e dados comuns (como parcelas)
rAcrescimoParaJuros :: Double -> Double -> Int -> Double -> Double -> Double -> Double
rAcrescimoParaJuros acrescimo minDiferenca iteracaoAtual minJuros maxJuros medJuros
  | iteracaoAtual == 0 = medJuros
  | (maxJuros - minJuros) < minDiferenca = medJuros
  | jurosParaAcrescimo medJuros < acrescimo = rAcrescimoParaJuros acrescimo minDiferenca (iteracaoAtual - 1) medJuros maxJuros ((medJuros + maxJuros) / 2.0)
  | otherwise = rAcrescimoParaJuros acrescimo minDiferenca (iteracaoAtual - 1) minJuros medJuros ((minJuros + medJuros) / 2.0)

-- função açúcar que calcula os juros a partir do acréscimo e dados comuns (como parcelas)
acrescimoParaJuros :: Double -> Long -> Int -> Double -> Double
acrescimoParaJuros acrescimo precisao maxIteracoes maxJuros =
  rAcrescimoParaJuros acrescimo (powint 0.1 precisao) maxIteracoes 0.0 maxJuros (maxJuros / 2.0)

-- testa as funções
main _ = do
  -- calcula e guarda os resultados das funções
  let pesoTotal = getPesoTotal
  let acrescimoCalculado = jurosParaAcrescimo 3.0
  let jurosCalculado = acrescimoParaJuros acrescimoCalculado 15 65 50.0

  -- imprime os resultados
  print "Peso total = "
  println pesoTotal
  print "Acréscimo = "
  println acrescimoCalculado
  print "Juros = "
  println jurosCalculado
