// Cálculo do juros, sendo que precisa de arrays pra isso
// Versão 0.1: 01/04/2026: versão feita sem muito conhecimento de Gluon
//        0.2: 23/08/2026: funções recursivas alteradas para permitir Tail Call Optimization (TCO)

// RESUMO DAS DIFERENÇAS ENTRE OS BENCHMARKS COM 300.000 PARCELAS SOBRE A VERSÃO COM LISTAS E SOBRE A VERSÃO COM ARRAYS (ESTA):
// a versão com listas levou uma média de 46,460s e a versão com arrays levou uma média de 5m16.468s (≃6,81162 vezes maior)
// a versão com listas necessitou de ter o tamanho da pilha alterado com ulimit -s 16384
// (não foram feitos testes exaustivos, somente potências de 2) o que fortemente sugere que a TCO não ocorreu
// a versão com arrays não necessitou de ter o tamanho da pilha alterado, o que fortemente sugere que a TCO ocorreu

let array = import! std.array
let bool = import! std.bool
let float = import! std.float
let io @ { ? } = import! std.io

// globais escalares para simplificar as chamadas às funções, inicializadas
let quantidade : Int = 300000
let composto : Bool = True
let periodo : Float = 30.0

// função recursiva que cria um array para pagamentos
rec let rGeraPagamentos indice acumulador :
    Int -> Array Float -> Array Float =
    if indice < 0 then acumulador
    else rGeraPagamentos (indice - 1) (array.append acumulador [periodo * (float.from_int (indice + 1))])

// função recursiva que cria um array para pesos
rec let rGeraPesos indice acumulador :
    Int -> Array Float -> Array Float =
    if indice < 0 then acumulador
    else rGeraPesos (indice - 1) (array.append acumulador [1.0])

// função recursiva que calcula a somatória dos elementos no array pesos
rec let rGetPesoTotal pesos indice acumulador :
    Array Float -> Int -> Float -> Float =
    if indice < 0 then acumulador
    else rGetPesoTotal pesos (indice - 1) (acumulador + (array.index pesos indice))

// função recursiva que calcula a somatória das amortizações nos juros compostos
rec let rJurosCompostos pagamentos pesos juros indice acumulador :
    Array Float -> Array Float -> Float -> Int -> Float -> Float =
    if indice < 0 then acumulador
    else rJurosCompostos pagamentos pesos juros (indice - 1) (acumulador + (array.index pesos indice) / (float.powf (1.0 + juros / 100.0) ((array.index pagamentos indice) / periodo)))

// função recursiva que calcula a somatória das amortizações nos juros simples
rec let rJurosSimples pagamentos pesos juros indice acumulador :
    Array Float -> Array Float -> Float -> Int -> Float -> Float =
    if indice < 0 then acumulador
    else rJurosSimples pagamentos pesos juros (indice - 1) (acumulador + (array.index pesos indice) / (1.0 + juros / 100.0 * (array.index pagamentos indice) / periodo))

(\_ ->
    // funções açúcares que criam arrays para pagamentos e pesos
    let geraPagamentos : Array Float = rGeraPagamentos (quantidade - 1) []
    let geraPesos : Array Float = rGeraPesos (quantidade - 1) []

    // inicializa os arrays
    let pagamentos : Array Float = geraPagamentos
    let pesos : Array Float = geraPesos

    // função açúcar que calcula a somatória dos elementos no array pesos
    let getPesoTotal : Float = rGetPesoTotal pesos (quantidade - 1) 0.0

    // função (meio açúcar) que calcula o acréscimo a partir dos juros e parcelas
    let jurosParaAcrescimo juros : Float -> Float =
        if composto then (getPesoTotal / (rJurosCompostos pagamentos pesos juros (quantidade - 1) 0.0) - 1.0) * 100.0
        else (getPesoTotal / (rJurosSimples pagamentos pesos juros (quantidade - 1) 0.0) - 1.0) * 100.0

    // função recursiva que calcula os juros a partir do acréscimo e parcelas
    rec let rAcrescimoParaJuros acrescimo minDiferenca iteracao minJuros maxJuros medJuros :
        Float -> Float -> Int -> Float -> Float -> Float -> Float =
        if iteracao < 1 || (maxJuros - minJuros) < minDiferenca then medJuros
        else if (jurosParaAcrescimo medJuros) < acrescimo
            then rAcrescimoParaJuros acrescimo minDiferenca (iteracao - 1) medJuros maxJuros ((medJuros + maxJuros) / 2.0)
            else rAcrescimoParaJuros acrescimo minDiferenca (iteracao - 1) minJuros medJuros ((minJuros + medJuros) / 2.0)

    (\_ ->
        // função açúcar que calcula os juros a partir do acréscimo e parcelas
        let acrescimoParaJuros acrescimo precisao maxIteracoes maxJuros : 
            Float -> Int -> Int -> Float -> Float =
            rAcrescimoParaJuros acrescimo (float.powi 0.1 precisao) maxIteracoes 0.0 maxJuros (maxJuros / 2.0)

        // calcula e guarda os resultados das funções
        let pesoTotal : Float = getPesoTotal
        let acrescimoCalculado : Float = jurosParaAcrescimo 3.0
        let jurosCalculado : Float = acrescimoParaJuros acrescimoCalculado 15 65 50.0

        // imprime os resultados
        seq io.print "Peso total  = "
        io.println (show pesoTotal)
        seq io.print "Acréscimo  = "
        io.println (show acrescimoCalculado)
        seq io.print "Juros  = "
        io.println (show jurosCalculado)
    ) ()
) ()
