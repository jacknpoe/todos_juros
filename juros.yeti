// Cálculo dos juros, sendo que precisa de arrays pra isso
// Versão 0.1: 31/05/2024: completo, mas sem saber muito sobre Yeti
//        0.2: 12/11/2026: arrays escaláveis preenchidos dinamicamente; melhorias nos comentários; removidos casos especiais;
//                         validados variáveis, parâmetros e cálculos; funções recursivas alteradas para permitir Tail Call Optimization (TCO)

// variáveis escalares globais para simplificar as chamadas
quantidade = 3;
composto = true;
periodo = 30.0;
pagamentos = array [];
pesos = array [];

// função recursiva que preenche o array pagamentos[]
rPreenchePagamentos indice = 
    if indice <= quantidade then
        push pagamentos (indice * periodo);
        rPreenchePagamentos (indice + 1)
    fi;

// função açúcar que preenche o array pagamentos[]
preenchePagamentos () = rPreenchePagamentos 1;

// função recursiva que preenche o array pesos[]
rPreenchePesos indice = 
    if indice <= quantidade then
        push pesos 1.0;
        rPreenchePesos (indice + 1)
    fi;

// função açúcar que preenche o array pesos[]
preenchePesos () = rPreenchePesos 1;

// função recursiva que calcula a somatória de pesos[]
rGetPesoTotal indice acumulador =
    if indice < 0 then acumulador
    else rGetPesoTotal (indice - 1) (pesos[indice] + acumulador) fi;

// função açúcar que calcula a somatória de pesos[]
getPesoTotal () = rGetPesoTotal (quantidade - 1) 0.0;

// calcula a soma da amortização de todas as parcelas para juros compostos
rJurosCompostos indice juros acumulador =
    if indice < 0 then acumulador
    else rJurosCompostos (indice - 1) juros (pesos[indice] / exp((pagamentos[indice] / periodo) * ln(1.0 + juros / 100.0)) + acumulador) fi;

// calcula a soma da amortização de todas as parcelas para juros simples
rJurosSimples indice juros acumulador =
    if indice < 0 then acumulador
    else rJurosSimples (indice - 1) juros (pesos[indice] / (1.0 + juros / 100.0 * pagamentos[indice] / periodo) + acumulador) fi;

// calcula o acréscimo a partir dos juros e dados comuns (como parcelas)
jurosParaAcrescimo juros = (
    pesoTotal = getPesoTotal ();
    if quantidade < 1 or periodo <= 0.0 or pesoTotal <= 0.0 or juros <= 0.0 then 0.0
    else
        acumulador = if composto then rJurosCompostos (quantidade - 1) juros 0.0
                     else rJurosSimples (quantidade - 1) juros 0.0 fi;
        if acumulador <= 0.0 then 0.0
        else (pesoTotal / acumulador - 1.0) * 100.0 fi
    fi
);

// função recursiva que calcula os juros a partir do acréscimo e dados comuns (como parcelas)
rAcrescimoParaJuros acrescimo minDiferenca iteracaoAtual minJuros maxJuros medJuros =
    if iteracaoAtual == 0 or (maxJuros - minJuros) <= minDiferenca then medJuros
    else if jurosParaAcrescimo medJuros <= acrescimo
         then rAcrescimoParaJuros acrescimo minDiferenca (iteracaoAtual - 1) medJuros maxJuros ((medJuros + maxJuros) / 2.0)
         else rAcrescimoParaJuros acrescimo minDiferenca (iteracaoAtual - 1) minJuros medJuros ((minJuros + medJuros) / 2.0)
         fi
    fi;

// função açúcar que calcula os juros a partir do acréscimo e dados comuns (como parcelas)
acrescimoParaJuros acrescimo precisao maxIteracoes maxJuros = (
    pesoTotal = getPesoTotal ();
    if quantidade < 1 or periodo <= 0.0 or pesoTotal <= 0.0 or acrescimo <= 0.0 or precisao < 1 or maxIteracoes < 1 or maxJuros <= 0.0 then 0.0
    else rAcrescimoParaJuros acrescimo (exp(precisao * ln(0.1))) maxIteracoes 0.0 maxJuros (maxJuros / 2.0) fi
);  

// preenche os arrays pagamentos[] e pesos[]
preenchePagamentos ();
preenchePesos ();

// calcula e guarda os resultados das funções
pesoTotal = getPesoTotal ();
acrescimoCalculado = jurosParaAcrescimo 3.0;
jurosCalculado = acrescimoParaJuros acrescimoCalculado 15 65 50.0;

// imprime os resultados
println "Peso total = \(pesoTotal)";
println "Acréscimo = \(acrescimoCalculado)";
println "Juros = \(jurosCalculado)";
