;; Cálculo do juros, sendo que precisa de listas pra isso
;; Versão 0.1: 21/11/2026: a partir de Common Lisp, alterações em ao menos 33 pontos, sem muita ajuda do YLISP

;; RODAR: ylr <caminho init.yl>/init.yl juros.yl | grep -E "^(Peso|Acrescimo|Juros)"
;; ATENÇÃO: para rodar usando ylr precisa alterar o código-fonte e recompilar, inclusive habilitando a função pow

;; variáveis escalares globais para simplificar chamadas
(set 'Quantidade 3)
(set 'Composto 't)  ;; 1 = TRUE
(set 'Periodo 30.0)

(defun criaPagamentos () "função açúcar que cria a lista Pagamentos" (_criaPagamentos Quantidade))

(defun _criaPagamentos (indice) "função recursiva não-TCO que cria a lista Pagamentos"
  (cond ((<= indice 0) '())
    ('t (cons (* indice Periodo) (_criaPagamentos (- indice 1)))
    )
  )
)

(defun criaPesos () "função açúcar que cria a lista Pesos" (_criaPesos Quantidade))

(defun _criaPesos (indice) "função recursiva não-TCO que cria a lista Pesos"
  (cond ((<= indice 0) '())
    ('t (cons 1.0 (_criaPesos (- indice 1))))
  )
)

;; listas globais para simplificar chamadas
(set 'Pagamentos (criaPagamentos))
(set 'Pesos (criaPesos))

(defun getPesoTotal() "função açúcar que calcula a somatória de Pesos" (_getPesoTotal Pesos))

(defun _getPesoTotal (ppesos) "função recursiva não-TCO que calcula a somatória de Pesos"
  (cond ((null ppesos) 0.0)
    ('t (+ (car ppesos) (_getPesoTotal (cdr ppesos))))
  )
)

(defun jurosParaAcrescimo (juros) "função que calcula o acréscimo a partir dos juros e dados comuns (como parcelas)"
  (cond ((or (<= juros 0.0) (<= Quantidade 0) (<= Periodo 0.0)) 0.0)
    ('t (let ((lpesoTotal (getPesoTotal)))
      (cond ((<= lpesoTotal 0.0) 0.0)
        ('t (let (( acumulador
          (cond (Composto (_jurosCompostos Pagamentos Pesos juros))
            ('t (_jurosSimples Pagamentos Pesos juros))
          )
          ))
          (cond ((<= acumulador 0.0) 0.0)
            ('t (* (- (/ lpesoTotal acumulador) 1.0) 100.0))
          )
        ))
      )
    ))
  )
)

(defun _jurosCompostos (ppagamentos ppesos juros) "função recursiva não-TCO que calcula a soma da amortização de todas as parcelas para juros compostos"
  (cond ((null ppesos) 0.0)
    ('t (+ (* (car ppesos) (pow (+ 1.0 (/ juros 100.0)) (- 0.0 (/ (car ppagamentos) Periodo)))) (_jurosCompostos (cdr ppagamentos) (cdr ppesos) juros)))
  )
)

(defun _jurosSimples (ppagamentos ppesos juros) "função recursiva não-TCO que calcula a soma da amortização de todas as parcelas para juros simples"
  (cond ((null ppesos) 0.0)
    ('t (+ (/ (car ppesos) (+ 1.0 (* (/ juros 100.0) (/ (car ppagamentos) Periodo)))) (_jurosSimples (cdr ppagamentos) (cdr ppesos) juros)))
  )
)

(defun acrescimoParaJuros (acrescimo precisao maxIteracoes maxJuros) "função açúcar que calcula os juros a partir do acréscimo e dados comuns (como parcelas)"
  (cond ((or (<= acrescimo 0.0) (<= Quantidade 0) (<= Periodo 0.0) (< maxIteracoes 1) (< precisao 1) (<= maxJuros 0.0) (<= (getPesoTotal) 0.0)) 0.0)
    ('t (_acrescimoParaJuros acrescimo (pow 0.1 precisao) maxIteracoes 0.0 maxJuros (/ maxJuros 2.0)))
  )
)

(defun _acrescimoParaJuros (acrescimo minDiferenca iteracaoAtual minJuros maxJuros medJuros) "função recursiva que calcula os juros a partir do acréscimo e dados comuns (como parcelas)"
  (cond ((or (= iteracaoAtual 0)  (< (- maxJuros minJuros) minDiferenca)) medJuros)
    ('t (cond ((< (jurosParaAcrescimo medJuros) acrescimo) (_acrescimoParaJuros acrescimo minDiferenca (- iteracaoAtual 1) medJuros maxJuros (/ (+ medJuros maxJuros) 2.0)))
      ('t (_acrescimoParaJuros acrescimo minDiferenca (- iteracaoAtual 1) minJuros medJuros (/ (+ minJuros medJuros) 2.0)))
    ))
  )
)

(set 'escala (pow 10.0 15.0))
(defun escalaPrecisao (valor) "multiplica um valor pela escala" (* valor escala))

;; calcula e guarda os resultados das funções
(set 'pesoTotal (getPesoTotal))
(set 'acrescimoCalculado (jurosParaAcrescimo 3.0))
(set 'jurosCalculado (acrescimoParaJuros acrescimoCalculado 15 65 50.0))

;; imprime os resultados

(printf '"Peso total (×10¹⁵) = %s\nAcrescimo (×10¹⁵) = %s\nJuros (×10¹⁵) = %s\n"
  (escalaPrecisao pesoTotal)
  (escalaPrecisao acrescimoCalculado)
  (escalaPrecisao jurosCalculado)
)
