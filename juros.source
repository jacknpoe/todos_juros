// Cálculo do juros, sendo que precisa de arrays pra isso
// Versão 0.1: 24/02/2025: versão de testes a partir da de Node.js e Haskell
//        0.2: 25/02/2025: const no lugar de let para rodar a partir do Source §2
//        0.3: 01/11/2026: melhorias nos comentários, estéticas, undefined no final, listas escaladas, validações de variáveis, argumentos e cálculos
//                         alteradas funções recursivas para permitir Tail Call Optimization (TCO); embora não estoure mais a pilha, chega ao limite de tempo
//                         sem TCO, a pilha estourava com 912 parcelas, agora o limite de tempo para rodar o script é alcançado em torno de 10.465 parcelas

// PARA RODAR:
// abrir https://sourceacademy.org/playground
// escolher "JavaScript" §2 no canto superior direito
// copiar e colar esse código no editor de códigos
// rodar com "Run" próximo do canto superior esquerdo

// link da solução: https://share.sourceacademy.org/juros

// valores globais para simplificar as chamadas
const Quantidade = 3;
const Composto = true;
const Periodo = 30.0;

// função recursiva que cria a lista Pagamentos
function rCriaPagamentos(indice, acumulador) {
    return indice > Quantidade
        ? acumulador
        : rCriaPagamentos(indice + 1, pair(indice * Periodo, acumulador));
}

// função açúcar que cria a lista Pagamentos
function criaPagamentos() {
    return rCriaPagamentos(1, null);
}

// função recursiva que cria a lista Pesos
function rCriaPesos(indice, acumulador) {
    return indice > Quantidade
        ? acumulador
        : rCriaPesos(indice + 1, pair(1.0, acumulador));
}

// função açúcar que cria a lista Pesos
function criaPesos() {
    return rCriaPesos(1, null);
}

const Pagamentos = criaPagamentos();
const Pesos = criaPesos();

// função recursiva que retorna a soma total de todos os pesos
function rGetPesoTotal(lPesos, acumulador) {
    return is_null(lPesos)
        ? acumulador
        : rGetPesoTotal(tail(lPesos), head(lPesos) + acumulador);
}

// função açúcar que retorna a soma total de todos os pesos
function getPesoTotal() {
    return rGetPesoTotal(Pesos, 0.0);
}

// função recursiva que calcula a soma do amortecimento de todas as parcelas para juros compostos
function rJurosCompostos(juros, lPagamentos, lPesos, acumulador) {
    return is_null(lPesos)
        ? acumulador
        : rJurosCompostos(juros, tail(lPagamentos), tail(lPesos), head(lPesos) / math_pow(1.0 + juros / 100.0, head(lPagamentos) / Periodo) + acumulador);
}

// função recursiva que calcula a soma do amortecimento de todas as parcelas para juros simples
function rJurosSimples(juros, lPagamentos, lPesos, acumulador) {
    return is_null(lPesos)
        ? acumulador
        : rJurosSimples(juros, tail(lPagamentos), tail(lPesos), head(lPesos) / (1.0 + juros / 100.0 * head(lPagamentos) / Periodo) + acumulador);
}

// função que calcula o acréscimo a partir dos juros e dados comuns (como parcelas)
function jurosParaAcrescimo(juros) {
    const pesoTotal = getPesoTotal();
    
    if (Quantidade < 1 || Periodo <= 0.0 || pesoTotal <= 0.0 || juros <= 0.0) {
        return 0.0;
    } else {
        const acumulador = Composto
            ? rJurosCompostos(juros, Pagamentos, Pesos, 0.0)
            : rJurosSimples(juros, Pagamentos, Pesos, 0.0);

        return acumulador <= 0.0
            ? 0.0
            : (pesoTotal / acumulador - 1.0) * 100.0;
    }
}

// função recursiva que calcula os juros a partir do acréscimo e dados comuns (como parcelas)
function rAcrescimoParaJuros(acrescimo, minDiferenca, iteracaoAtual, minJuros, maxJuros, medJuros) {
    return iteracaoAtual === 0 || (maxJuros - minJuros) < minDiferenca
        ? medJuros
        : jurosParaAcrescimo(medJuros) < acrescimo
            ? rAcrescimoParaJuros(acrescimo, minDiferenca, iteracaoAtual - 1, medJuros, maxJuros, (medJuros + maxJuros) / 2.0)
            : rAcrescimoParaJuros(acrescimo, minDiferenca, iteracaoAtual - 1, minJuros, medJuros, (minJuros + medJuros) / 2.0);
}

// função açúcar que calcula os juros a partir do acréscimo e dados comuns (como parcelas)
function acrescimoParaJuros(acrescimo, precisao, maxIteracoes, maxJuros) {
    const pesoTotal = getPesoTotal();
    return Quantidade < 1 || Periodo <= 0.0 || pesoTotal <= 0.0 || acrescimo <= 0.0 || precisao < 1 || maxIteracoes < 1 || maxJuros <= 0.0
        ? 0.0
        : rAcrescimoParaJuros(acrescimo, math_pow(0.1, precisao), maxIteracoes, 0.0, maxJuros, maxJuros / 2.0);
}

// calcula e guarda os resultados das funções
const pesoTotal = getPesoTotal();
const acrescimoCalculado = jurosParaAcrescimo(3.0);
const jurosCalculado = acrescimoParaJuros(acrescimoCalculado, 18, 65, 50.0);

// imprime os resultados
display(pesoTotal, "Peso total = ");
display(acrescimoCalculado, "Acréscimo = ");
display(jurosCalculado, "Juros = ");

// para evitar que jurosCalculado seja impresso depois de "Peso total = x"
undefined;
